# ===================================================================
# CRM System Environment Variables (Vercel & Production)
# ===================================================================

# 1. GOOGLE_SERVICE_ACCOUNT_JSON (REQUIRED FOR VERCEL & PRODUCTION)
# Paste the full contents of your Google Cloud Service Account JSON file as a single-line JSON string.
# Purpose: Authorizes the backend to read/write persistent CRM data directly on Google Drive (Source of Truth).
# Type: Secret
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"YOUR_PROJECT_ID","private_key_id":"YOUR_KEY_ID","private_key":"-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n","client_email":"YOUR_SERVICE_ACCOUNT_EMAIL@YOUR_PROJECT.iam.gserviceaccount.com"}

# 2. GOOGLE_DRIVE_FOLDER_ID (OPTIONAL)
# Purpose: Specify a custom Google Drive Folder ID. If left empty, defaults to creating/using a folder named "CRM_SYSTEM_DATA".
# Type: String / Non-secret
GOOGLE_DRIVE_FOLDER_ID=

# 3. GEMINI_API_KEY (OPTIONAL)
# Purpose: Enable Gemini AI Agent, Voice Assistant, and Automated Smart Insights.
# Type: Secret
GEMINI_API_KEY=

# 4. NODE_ENV (PRODUCTION SETTING)
# Purpose: Set execution environment mode.
# Type: String
NODE_ENV=production
